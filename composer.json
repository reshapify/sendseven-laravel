{
    "name": "reshapify/laravel-sendseven",
    "description": "SendSeven for Laravel: configured client, verified webhooks as Laravel events, channel onboarding redirects, a shared rate limit and a doctor command.",
    "keywords": [
        "sendseven",
        "laravel",
        "whatsapp",
        "sms",
        "webhooks",
        "messaging"
    ],
    "homepage": "https://github.com/reshapify/laravel-sendseven",
    "license": "MIT",
    "authors": [
        {
            "name": "Richard Bowen",
            "email": "rbowen@tutanota.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/cache": "^12.0||^13.0",
        "illuminate/console": "^12.0||^13.0",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/routing": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "reshapify/sendseven": "^0.1",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../sendseven-php",
            "options": {
                "versions": {
                    "reshapify/sendseven": "0.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Reshapify\\SendSeven\\Laravel\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Reshapify\\SendSeven\\Laravel\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php vendor/bin/testbench package:discover --ansi",
        "lint": "pint",
        "refactor": "rector",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run",
        "test:types": "phpstan analyse --ansi --memory-limit=1G",
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:unit": "pest --colors=always",
        "test": [
            "@test:lint",
            "@test:refactor",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Reshapify\\SendSeven\\Laravel\\SendSevenServiceProvider"
            ],
            "aliases": {
                "SendSeven": "Reshapify\\SendSeven\\Laravel\\Facades\\SendSeven"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
